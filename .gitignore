# After Effects
*.aep
*.aep.lock
Adobe After Effects Auto-Save/

# Bulk map data (~73 MB) — re-downloadable, see docs/geolayers-3-via-mcp.md
data/historical-basemaps/

# Derived geometry — regenerate with: python data/clip_region.py <year>
data/clipped/

# Downloaded portraits — refetch with: python scripts/prepare_work.py
# (the credit line is kept in the work JSON, which IS tracked)
data/portraits/

# Downloaded sound effect — refetch with: python scripts/fetch_sfx.py
# (the CC-BY credit is kept in data/audio/credits.json, which IS tracked)
data/audio/*.wav

# API response cache for prepare_work.py
data/.cache/

# Baked maps: a PNG sequence per work (the continent-to-city move), or a
# single still for a work whose map does not move.
# Regenerate with SOTD.mapDraw/mapFinish/mapZoom/mapFinalize/freezeMap
data/maps/

# Design-review export — regenerate with scripts/export_design_html.py
# (embeds copies of the untracked portraits and map stills)
design/

# Python
__pycache__/
*.pyc

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Recorded takes and everything derived from one. The recording is the master
# and belongs wherever you keep footage; align.json and locked.mp4 are both
# regenerable from it with take_transcribe.py + take_align.py.
data/takes/

# Rendered reels — SOTD.renderReel(slug), then scripts/reel_master.py <slug>
out/

# The speech recogniser. Not a project dependency: rebuild it with
#   python -m venv .venv-asr
#   .venv-asr/Scripts/python -m pip install faster-whisper
# (the model itself caches into data/.cache/, already ignored above)
.venv-asr/
